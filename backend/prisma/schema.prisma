// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── WHATSAPP/CRM MODELS ───────────────────────────────────────────────────

model Lead {
  id              String   @id @default(cuid())
  phoneNumber     String   @unique
  contactName     String?
  stage           String   @default("inbox") // inbox, hoje, acompanhar, pessoal, concluido, pausado
  score           Int      @default(50)
  lastMessageAt   DateTime?
  lastMessageText String?
  isGroup         Boolean  @default(false)
  customData      String? // JSON stored as string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations Conversation[]
  labels        LeadLabel[]
  events        LeadEvent[]

  @@index([phoneNumber])
  @@index([stage])
  @@index([createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  leadId        String
  title         String?
  lastMessageAt DateTime?
  messageCount  Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([leadId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  content        String
  contentType    String   @default("text")
  messageId      String   @unique
  timestamp      DateTime
  fromPhone      String   // "lead" or "bot"
  ackStatus      Int      @default(1) // 1=sent, 2=delivered, 3=read
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
  @@index([fromPhone])
}

model LeadLabel {
  id        String   @id @default(cuid())
  leadId    String
  labelType String   // vip, familia, trabalho, igreja, followup, urgente
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, labelType])
  @@index([labelType])
}

model LeadEvent {
  id          String   @id @default(cuid())
  leadId      String
  eventType   String   // created, message_received, message_sent, stage_changed, label_added
  description String?
  metadata    String? // JSON stored as string
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([eventType])
  @@index([createdAt])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  embedding String? // Vector stored as JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
