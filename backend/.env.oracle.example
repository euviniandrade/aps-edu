# ============================================================
#  APS EDU — Backend — Oracle Cloud (aps-edu-whatsapp)
#  Copie para .env e preencha os valores reais
# ============================================================

# Banco de dados (PostgreSQL local na VM)
DATABASE_URL="postgresql://aps_user:SENHA_AQUI@localhost:5432/aps_edu"

# Redis local
REDIS_URL="redis://localhost:6379"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GERE_AQUI_64_BYTES_HEX"
JWT_REFRESH_SECRET="GERE_OUTRO_AQUI_64_BYTES_HEX"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3000
NODE_ENV=production

# ─── WhatsApp ───────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_CLIENT_ID=aps-edu
WHATSAPP_SESSION_PATH=/opt/aps-edu/backend/.wwebjs_auth
WHATSAPP_MEMORY_PATH=/opt/aps-edu/backend/.wwebjs_auth/sofi-whatsapp-memory.json
WHATSAPP_AI_MODE=assist
WHATSAPP_GEMINI_MODEL=gemini-1.5-flash

# Caminho do Chromium instalado via apt
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Google Gemini (respostas automáticas da Sofi)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# ─── CORS ───────────────────────────────────────────────────
# URL do front-end Vercel (sem barra no final)
CORS_ORIGIN=https://SEU_PROJETO.vercel.app

# ─── Opcionais ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aps.edu.br
