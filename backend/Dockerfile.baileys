FROM node:20-slim

WORKDIR /app

# Instala apenas dependências mínimas (sem Chrome)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Instala dependências com npm ci (mais confiável que install)
RUN npm ci --omit=dev

# Copia código
COPY . .

# Cria pasta de dados
RUN mkdir -p /data

EXPOSE 8081

# Inicia usando whatsapp-baileys.js como whatsapp.js
CMD ["node", "whatsapp-baileys.js"]
