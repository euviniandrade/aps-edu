# Copie para .env (desenvolvimento) ou configure com `fly secrets set` (produção). Nunca commite o .env.

# Acesso ao app
APP_SENHA=troque-por-uma-senha-forte
SESSION_SECRET=gere-com-openssl-rand-hex-32

# Banco (em produção o fly.toml já aponta para /data/caixa.db)
DB_FILE=./data/caixa.db

# IA — configure pelo menos uma. Gemini também transcreve os áudios do WhatsApp.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: trocar modelos
# IA_MODELO_RAPIDO=
# IA_MODELO=

# WhatsApp Cloud API (Meta) — veja o README
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=invente-um-texto-qualquer
# Seu número pessoal (o único atendido pelo robô), com DDI: 5511999999999
WA_NUMERO_DONO=
# WA_GRAPH_VERSION=v21.0
